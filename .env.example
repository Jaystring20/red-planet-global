# Inquiry persistence. Create a dedicated Supabase project, apply
# supabase/migrations/0001_rp_inquiries.sql, then fill these in.
# The service role key is server-only and must never be prefixed NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Inquiry notification email. Verify the sending domain in Resend first.
RESEND_API_KEY=
RESEND_FROM="Red Planet Global <no-reply@redplanetglobal.com>"
